+    #[tokio::test(start_paused = true)]
+    async fn drain_distinguishes_a_stopped_head_from_an_unreachable_head() {
+        for unreachable in [false, true] {
+            let l1 = Asserter::new();
+            let zones = [Asserter::new(), Asserter::new()];
+            let leader = Address::repeat_byte(1);
+            for _ in 0..=TRIGGER_WATCH.as_millis() / TRIGGER_POLL.as_millis() {
+                if unreachable {
+                    zones[0].push_success(&Option::<Block<B256>>::None);
+                } else {
+                    queue_head(&zones[0], 10, leader);
+                }
+                queue_head(&zones[1], 10, leader);
+                l1.push_failure_msg("L1 unavailable; only a stopped reachable head may trigger");
+            }
+            let (_dir, ctx) = trigger_context(l1, &zones);
+            let started = Instant::now();
+            let result = await_trigger(
+                &ctx,
+                1,
+                10,
+                Trigger::Drain {
+                    delay_ms: 75,
+                    leader: 0,
+                    leader_head: Head {
+                        height: 10,
+                        hash: B256::from(U256::from(10)),
+                        producer: leader,
+                    },
+                    successor: Address::repeat_byte(2),
+                    epoch: 7,
+                },
+                started,
+            )
+            .await;
+            if unreachable {
+                let error = result.unwrap_err();
+                assert_eq!(
+                    error.to_string(),
+                    "leader drain was not observed before the trigger deadline"
+                );
+                assert!(error.downcast_ref::<tokio::time::error::Elapsed>().is_some());
+                assert_eq!(started.elapsed(), TRIGGER_WATCH);
+            } else {
+                result.unwrap();
+                assert_eq!(started.elapsed(), DRAIN_STALL + Duration::from_millis(75));
+            }
+        }
+    }
