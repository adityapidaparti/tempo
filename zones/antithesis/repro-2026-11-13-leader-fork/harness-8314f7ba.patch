+/// A published leader fsync delay; dropping it restores normal fsync.
+struct SlowFsync {
+    dir: PathBuf,
+    node: usize,
+    armed: bool,
+}
+
+impl SlowFsync {
+    fn set(dir: &Path, node: usize, delay_ms: u64) -> eyre::Result<Self> {
+        write_fsync_delay(dir, node, delay_ms)?;
+        Ok(Self {
+            dir: dir.to_path_buf(),
+            node,
+            armed: true,
+        })
+    }
+
+    fn clear(mut self) -> eyre::Result<()> {
+        write_fsync_delay(&self.dir, self.node, 0)?;
+        self.armed = false;
+        Ok(())
+    }
+}
+
+impl Drop for SlowFsync {
+    fn drop(&mut self) {
+        if self.armed
+            && let Err(error) = write_fsync_delay(&self.dir, self.node, 0)
+        {
+            eprintln!("slow-fsync reset failed: {error:#}");
+        }
+    }
+}
+
+/// Restores normal fsync on every controlled sequencer, after an interrupted episode.
+pub(super) fn release_slow_fsync(dir: &Path) -> eyre::Result<()> {
+    for node in 0..3 {
+        write_fsync_delay(dir, node, 0)?;
+    }
+    Ok(())
+}
+
+/// Atomically publishes `/fault-control/fsync-<node>`, which the node's slow-fsync shim reads.
+fn write_fsync_delay(dir: &Path, node: usize, delay_ms: u64) -> eyre::Result<()> {
+    let name = format!("fsync-{node}");
+    let temporary = dir.join(format!(".{name}.{}.tmp", std::process::id()));
+    fs::write(&temporary, delay_ms.to_string()).wrap_err("failed writing slow-fsync control")?;
+    fs::rename(&temporary, dir.join(&name)).wrap_err("failed publishing slow-fsync control")
+}
