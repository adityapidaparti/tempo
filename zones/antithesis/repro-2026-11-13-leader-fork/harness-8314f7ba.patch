+/// Waits until `trigger` fires. A backfill watch fires anyway after [`TRIGGER_WATCH`]; a drain
+/// watch must observe a transition within that bound. Blind delays start at `released_at`.
+async fn await_trigger(
+    ctx: &Context,
+    follower: usize,
+    base: u64,
+    trigger: Trigger,
+    released_at: Instant,
+) -> eyre::Result<()> {
+    match trigger {
+        Trigger::HeadMoves { delay_ms } => {
+            let deadline = Instant::now() + TRIGGER_WATCH;
+            while Instant::now() < deadline {
+                if read_tip(&ctx.zones[follower]).await.is_some_and(|tip| tip > base) {
+                    break;
+                }
+                tokio::time::sleep(TRIGGER_POLL).await;
+            }
+            tokio::time::sleep(Duration::from_millis(delay_ms)).await;
+        }
+        Trigger::Blind { delay_ms } => {
+            tokio::time::sleep_until(released_at + Duration::from_millis(delay_ms)).await;
+        }
+        Trigger::Drain {
+            delay_ms,
+            leader,
+            leader_head,
+            successor,
+            epoch,
+        } => {
+            let mut last_leader = leader_head;
+            let mut changed_at = Instant::now();
+            let mut poll = tokio::time::interval(TRIGGER_POLL);
+            poll.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+            timeout(TRIGGER_WATCH, async {
+                loop {
+                    poll.tick().await;
+                    let (leader_head, successor_head, current) = tokio::join!(
+                        read_head(&ctx.zones[leader]),
+                        read_head(&ctx.zones[follower]),
+                        timeout(TIP_READ_TIMEOUT, ctx.outage_membership(BlockId::latest()))
+                    );
+                    let current_epoch = match current {
+                        Ok(Ok(current)) => Some(current.epoch),
+                        Ok(Err(error)) => {
+                            println!("lagging-backfill-crash: drain epoch unavailable: {error:#}");
+                            None
+                        }
+                        Err(_) => None,
+                    };
+                    let now = Instant::now();
+                    if let Some(head) = leader_head {
+                        if head != last_leader {
+                            last_leader = head;
+                            changed_at = now;
+                        }
+                    } else {
+                        // An unreachable head cannot prove that production stopped.
+                        changed_at = now;
+                    }
+                    let reason = if successor_head
+                        .is_some_and(|head| head.height > base && head.producer == successor)
+                    {
+                        Some("successor_produced")
+                    } else if current_epoch.is_some_and(|current| current != epoch) {
+                        Some("portal_epoch_changed")
+                    } else if leader_head.is_some()
+                        && now.duration_since(changed_at) >= DRAIN_STALL
+                    {
+                        Some("leader_head_stopped")
+                    } else {
+                        None
+                    };
+                    if let Some(reason) = reason {
+                        println!(
+                            "lagging-backfill-crash: {}",
+                            json!({"step": "drain_observed", "reason": reason,
+                                "epoch": current_epoch, "leader": leader, "successor": follower,
+                                "leader_head": leader_head, "successor_head": successor_head})
+                        );
+                        break;
+                    }
+                }
+            })
+            .await
+            .wrap_err("leader drain was not observed before the trigger deadline")?;
+            tokio::time::sleep(Duration::from_millis(delay_ms)).await;
+        }
+    }
+    Ok(())
+}
+
+/// Reads a node's tip, or `None` if it does not answer within [`TIP_READ_TIMEOUT`].
+async fn read_tip(zone: &DynProvider) -> Option<u64> {
+    timeout(TIP_READ_TIMEOUT, zone.get_block_number())
+        .await
+        .ok()
+        .and_then(Result::ok)
+}
+
+/// Reads a head with its hash and producer without delaying the kill on an unresponsive node.
+async fn read_head(zone: &DynProvider) -> Option<Head> {
+    match timeout(
+        TIP_READ_TIMEOUT,
+        zone.get_block_by_number(BlockNumberOrTag::Latest),
+    )
+    .await
+    {
+        Ok(Ok(Some(block))) => Some(Head {
+            height: block.header.number,
+            hash: block.header.hash,
+            producer: block.header.beneficiary,
+        }),
+        Ok(Ok(None)) | Err(_) => None,
+        Ok(Err(error)) => {
+            println!("lagging-backfill-crash: head unavailable: {error}");
+            None
+        }
+    }
+}
