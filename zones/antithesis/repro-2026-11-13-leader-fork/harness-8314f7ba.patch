diff --git a/contrib/antithesis/zones/shim/slowsync.c b/contrib/antithesis/zones/shim/slowsync.c
new file mode 100644
index 00000000..af9aedb3
--- /dev/null
+++ b/contrib/antithesis/zones/shim/slowsync.c
@@ -0,0 +1,79 @@
+// Test-only slow-disk shim: delays fsync-family calls that target MDBX data files by the number
+// of milliseconds in $SLOWSYNC_CONTROL (re-read at most every 200 ms). Models a slow disk; it
+// changes no data and no ordering, only how long the durability barrier takes.
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+
+static long cached_ms = 0;
+static struct timespec last_read = {0, 0};
+
+static long delay_ms(void) {
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    long elapsed = (now.tv_sec - last_read.tv_sec) * 1000 + (now.tv_nsec - last_read.tv_nsec) / 1000000;
+    if (last_read.tv_sec != 0 && elapsed < 200) return cached_ms;
+    last_read = now;
+    const char *path = getenv("SLOWSYNC_CONTROL");
+    long ms = 0;
+    if (path) {
+        FILE *f = fopen(path, "r");
+        if (f) { if (fscanf(f, "%ld", &ms) != 1) ms = 0; fclose(f); }
+    }
+    if (ms < 0 || ms > 60000) ms = 0;
+    cached_ms = ms;
+    return ms;
+}
+
+static int is_mdbx_fd(int fd) {
+    char link[64], target[512];
+    snprintf(link, sizeof link, "/proc/self/fd/%d", fd);
+    ssize_t n = readlink(link, target, sizeof target - 1);
+    if (n <= 0) return 0;
+    target[n] = 0;
+    return strstr(target, "mdbx.dat") != NULL;
+}
+
+static void maybe_sleep(int is_mdbx) {
+    if (!is_mdbx) return;
+    long ms = delay_ms();
+    if (ms <= 0) return;
+    struct timespec ts = {ms / 1000, (ms % 1000) * 1000000};
+    nanosleep(&ts, NULL);
+}
+
+int fsync(int fd) {
+    static int (*real)(int);
+    if (!real) real = dlsym(RTLD_NEXT, "fsync");
+    maybe_sleep(is_mdbx_fd(fd));
+    return real(fd);
+}
+
+int fdatasync(int fd) {
+    static int (*real)(int);
+    if (!real) real = dlsym(RTLD_NEXT, "fdatasync");
+    maybe_sleep(is_mdbx_fd(fd));
+    return real(fd);
+}
+
+int sync_file_range(int fd, off64_t off, off64_t n, unsigned int flags) {
+    static int (*real)(int, off64_t, off64_t, unsigned int);
+    if (!real) real = dlsym(RTLD_NEXT, "sync_file_range");
+    maybe_sleep(is_mdbx_fd(fd));
+    return real(fd, off, n, flags);
+}
+
+// MDBX in the default (non-WRITEMAP) mode syncs with fdatasync/fsync; in WRITEMAP mode with msync.
+// msync carries no fd, so delay every MS_SYNC msync (only MDBX uses synchronous msync here).
+int msync(void *addr, size_t len, int flags) {
+    static int (*real)(void *, size_t, int);
+    if (!real) real = dlsym(RTLD_NEXT, "msync");
+    maybe_sleep((flags & MS_SYNC) != 0);
+    return real(addr, len, flags);
+}
