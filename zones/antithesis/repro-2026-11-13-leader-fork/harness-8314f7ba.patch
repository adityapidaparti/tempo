+
+    fn trigger_context(l1: Asserter, zones: &[Asserter; 2]) -> (tempfile::TempDir, Context) {
+        let dir = tempfile::tempdir().unwrap();
+        let url = "http://localhost:8545".parse::<reqwest::Url>().unwrap();
+        let ctx = Context {
+            ledger: Ledger::open(dir.path()).unwrap(),
+            http: reqwest::Client::new(),
+            l1_url: url.clone(),
+            l1: ProviderBuilder::new().connect_mocked_client(l1).erased(),
+            zone_urls: vec![url.clone(), url],
+            zones: zones
+                .iter()
+                .map(|zone| ProviderBuilder::new().connect_mocked_client(zone.clone()).erased())
+                .collect(),
+            portal: Address::repeat_byte(9),
+        };
+        (dir, ctx)
+    }
+
+    fn queue_head(zone: &Asserter, height: u64, producer: Address) {
+        let mut block = Block::<B256>::default();
+        block.header.number = height;
+        block.header.hash = B256::from(U256::from(height));
+        block.header.beneficiary = producer;
+        zone.push_success(&block);
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn blind_trigger_uses_confirmation_time_without_reading_rpc() {
+        for delay_ms in [0, MAX_BLIND_DRAIN_MS] {
+            let zones = [Asserter::new(), Asserter::new()];
+            let (_dir, ctx) = trigger_context(Asserter::new(), &zones);
+            let confirmed_at = Instant::now();
+            tokio::time::advance(TRIGGER_POLL).await;
+            let started = Instant::now();
+            await_trigger(&ctx, 1, 10, Trigger::Blind { delay_ms }, confirmed_at)
+                .await
+                .unwrap();
+            assert_eq!(
+                Instant::now(),
+                (confirmed_at + Duration::from_millis(delay_ms)).max(started)
+            );
+        }
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn drain_requires_an_advancing_head_produced_by_the_successor() {
+        let l1 = Asserter::new();
+        let zones = [Asserter::new(), Asserter::new()];
+        let leader = Address::repeat_byte(1);
+        let successor = Address::repeat_byte(2);
+        for (height, producer) in [(10, successor), (11, leader), (11, successor)] {
+            queue_head(&zones[0], 10, leader);
+            queue_head(&zones[1], height, producer);
+            l1.push_failure_msg("L1 unavailable; successor production must suffice");
+        }
+        let (_dir, ctx) = trigger_context(l1, &zones);
+        let started = Instant::now();
+        let delay_ms = 75;
+        await_trigger(
+            &ctx,
+            1,
+            10,
+            Trigger::Drain {
+                delay_ms,
+                leader: 0,
+                leader_head: Head {
+                    height: 10,
+                    hash: B256::from(U256::from(10)),
+                    producer: leader,
+                },
+                successor,
+                epoch: 7,
+            },
+            started,
+        )
+        .await
+        .unwrap();
+        assert_eq!(started.elapsed(), TRIGGER_POLL * 2 + Duration::from_millis(delay_ms));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn drain_observes_a_portal_epoch_change_without_successor_progress() {
+        let l1 = Asserter::new();
+        let zones = [Asserter::new(), Asserter::new()];
+        let leader = Address::repeat_byte(1);
+        let successor = Address::repeat_byte(2);
+        queue_head(&zones[0], 10, leader);
+        queue_head(&zones[1], 10, leader);
+        let mut block = Block::<B256>::default();
+        block.header.number = 100;
+        block.header.hash = B256::from(U256::from(100));
+        l1.push_success(&block);
+        l1.push_success(&Bytes::from(U256::from(2).abi_encode()));
+        l1.push_success(&Bytes::from(
+            (
+                U256::from(10),
+                vec![Bytes::from(leader.abi_encode()), Bytes::from(successor.abi_encode())],
