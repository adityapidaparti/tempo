+//! Crashes the leader during follower backfill or a leadership drain.
+//!
+//! Targets the window where the leader's persisted tip (`last_block_number`, the static-file tip)
+//! runs ahead of the database commit: a block served from that window and then lost to SIGKILL
+//! would be rebuilt differently at the same height, forking every follower that holds it. A
+//! test-only slow-fsync shim on the leader widens that window.
+
+use alloy::{
+    primitives::{Address, B256},
+    providers::{DynProvider, Provider as _},
+    rpc::types::{BlockId, BlockNumberOrTag},
+};
+use antithesis_sdk::{assert_always, assert_reachable, assert_sometimes};
+use eyre::{OptionExt as _, WrapErr as _};
+use serde::Serialize;
+use serde_json::json;
+use std::{
+    fmt, fs,
+    path::{Path, PathBuf},
+    time::Duration,
+};
+use tokio::time::{Instant, timeout};
+
+use super::{
+    ADMIN_INDEX, Account, Context, SEQUENCER_INDICES,
+    handoff::{Request, handoff_applied},
+    outage::Hold,
+    proxy::{Fault, release_network_faults},
+    random_below, random_index,
+    recovery::recover_until,
+};
+
+const EPISODES: usize = 6;
+const PRECONDITION_TIMEOUT: Duration = Duration::from_secs(180);
+// Stays below the supervisor's independent 180-second hold watchdog.
+const HOLD_TIMEOUT: Duration = Duration::from_secs(150);
+/// Bounds installing the P2P gate and holding it for at most [`MAX_GATE_MS`].
+const GATE_TIMEOUT: Duration = Duration::from_secs(150);
+/// Added to the gate duration for the lease deadline, the proxies' own release backstop.
+const GATE_LEASE_MARGIN: Duration = Duration::from_secs(20);
+const HEAL_TIMEOUT: Duration = Duration::from_secs(30);
+const RESTART_TIMEOUT: Duration = Duration::from_secs(60);
+const CONVERGENCE_TIMEOUT: Duration = Duration::from_secs(180);
+/// Follower process hold duration, in milliseconds.
+const MIN_HOLD_MS: u64 = 10_000;
+const MAX_HOLD_MS: u64 = 30_000;
+/// Follower P2P gate duration, in milliseconds.
+const MIN_GATE_MS: u64 = 10_000;
+const MAX_GATE_MS: u64 = 120_000;
+/// Upper bound of the random delay before the leader is killed, in milliseconds.
+const MAX_TRIGGER_DELAY_MS: u64 = 1_500;
+/// How long a trigger waits for the follower's head to move before firing anyway.
+const TRIGGER_WATCH: Duration = Duration::from_secs(60);
+const TRIGGER_POLL: Duration = Duration::from_millis(20);
+/// Bounds tip reads around the leader kill, so a starting node cannot delay it.
+const TIP_READ_TIMEOUT: Duration = Duration::from_millis(500);
+/// Leader MDBX fsync delays, in milliseconds, chosen per episode.
+const FSYNC_DELAYS_MS: [u64; 7] = [0, 200, 1_000, 5_000, 20_000, 45_000, 45_000];
+/// Delays that widen the outgoing leader's commit window during a drain.
+const DRAIN_FSYNC_DELAYS_MS: [u64; 5] = [600, 2_000, 5_000, 20_000, 45_000];
+const MAX_BLIND_DRAIN_MS: u64 = 3_000;
+/// Longer than a single slow commit; an unchanged 20 ms sample is not a stopped head.
+const DRAIN_STALL: Duration = Duration::from_secs(3);
+/// Below the wrapper's 1500-second timeout, so cancellation never cuts an episode short.
+const BUDGET: Duration = Duration::from_secs(1400);
+/// A new episode starts only with this much budget left: the worst-case episode.
+const EPISODE_RESERVE: Duration = Duration::from_secs(750);
+
+/// Asserts a phase outcome while faults are quiet; otherwise a failure is only logged as
+/// inconclusive and still returned, so the episode stops without further faults.
+macro_rules! phase {
+    ($quiet:expr, $message:literal, $duration:expr, $work:expr) => {{
+        let result = timeout($duration, $work)
+            .await
+            .wrap_err(concat!($message, ": timed out"))
+            .and_then(|result| result);
+        if $quiet {
+            assert_always!(
+                result.is_ok(),
+                concat!("Lagging backfill crash: ", $message),
+                &json!({"error": result.as_ref().err().map(|error| format!("{error:#}"))})
+            );
+        } else if let Err(error) = &result {
+            println!(
+                "lagging-backfill-crash: {}",
+                json!({"result": "INCONCLUSIVE", "phase": $message,
+                    "error": format!("{error:#}")})
+            );
+        }
+        result.wrap_err($message)
+    }};
+}
+
+/// How the follower is made to lag behind the leader.
+#[derive(Debug, Clone, Copy, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum Lag {
+    /// The follower's P2P traffic is gated, then healed.
+    Gate,
+    /// The follower process is killed, then restarted.
+    Restart,
+    /// No lag: the leader's commit stalls long enough that the follower's inactivity probe
+    /// backfills the leader's finalized-but-uncommitted tip.
+    Probe,
+}
+
+/// When the leader is killed after releasing a follower or confirming a handoff.
+#[derive(Debug, Clone, Copy, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum Trigger {
+    /// A random delay after the follower's head first passes its pre-release tip.
+    HeadMoves { delay_ms: u64 },
+    /// A random delay after releasing the follower or confirming the handoff.
+    Blind { delay_ms: u64 },
+    /// A random delay after successor production, an epoch change, or a stopped leader head.
+    Drain {
+        delay_ms: u64,
+        leader: usize,
+        leader_head: Head,
+        successor: Address,
+        epoch: u64,
+    },
+}
+
+/// A head observation, including the producer that identifies successor production.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+struct Head {
+    height: u64,
+    hash: B256,
+    producer: Address,
+}
+
+/// Marks a persistent fork, which fails the command even when faults are not quiet.
+#[derive(Debug)]
+struct Forked;
+
+impl fmt::Display for Forked {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("zone nodes hold different blocks at the same height")
+    }
+}
+
+impl std::error::Error for Forked {}
+
+impl Context {
+    /// With `quiet`, repeats bounded episodes under the exclusive episode lock: unprovable
+    /// handoff quiescence skips before any kill, and a started episode fails on timeouts or
+    /// missing evidence. Without it, runs one episode under the shared lock while platform
+    /// faults continue; only a fork fails it, anything else is inconclusive.
+    pub(super) async fn lagging_backfill_crash(
+        &self,
+        dir: &Path,
+        quiet: bool,
+    ) -> eyre::Result<()> {
+        let started = Instant::now();
+        let mut executed = 0;
+        let result = timeout(BUDGET, async {
+            let _lock = self.ledger.episode_lock(quiet).await?;
+            if quiet {
+                release_network_faults(dir).await?;
+                self.release_outages(dir).await?;
+                release_slow_fsync(dir)?;
+            }
+            eyre::ensure!(
+                self.zones.len() == 4,
+                "lagging backfill crash requires three sequencers and one RPC-only node"
+            );
+            let drained = recover_until(Instant::now() + PRECONDITION_TIMEOUT, async || {
+                let ready = self.handoffs_drained().await?;
+                if !ready {
+                    self.reconcile_intents().await?;
+                }
+                Ok(ready.then_some(()))
+            })
+            .await;
+            if drained.as_ref().is_err_and(|error| {
+                error.downcast_ref::<tokio::time::error::Elapsed>().is_some()
+            }) {
+                println!(
+                    "lagging-backfill-crash: {}",
+                    json!({"result": "SKIPPED",
+                        "reason": "handoff quiescence could not be proven before the deadline"})
+                );
+                return Ok(());
+            }
+            drained?;
+            let members = SEQUENCER_INDICES
+                .map(|index| Ok(Account::at(index)?.address()))
+                .collect::<eyre::Result<Vec<_>>>()?;
+            let episodes = if quiet { EPISODES } else { 1 };
+            for episode in 0..episodes {
+                if started.elapsed() + EPISODE_RESERVE > BUDGET {
+                    println!("lagging-backfill-crash: budget leaves no room for episode {episode}");
+                    break;
+                }
+                self.lagging_crash_episode(dir, &members, episode, quiet).await?;
+                executed += 1;
+            }
+            Ok(())
+        })
+        .await
+        .wrap_err("Lagging backfill crash episodes finish within the quiet window: timed out")
+        .and_then(|result| result);
+        assert_sometimes!(
+            executed > 0,
+            "Lagging backfill crash: Handoffs drain and a controlled episode executes",
+            &json!({"executed": executed, "quiet": quiet})
+        );
+        if !quiet {
+            return match result {
+                Err(error) if error.chain().any(|cause| cause.is::<Forked>()) => Err(error),
+                Err(error) => {
+                    println!(
+                        "lagging-backfill-crash: {}",
+                        json!({"result": "INCONCLUSIVE", "error": format!("{error:#}")})
+                    );
+                    Ok(())
+                }
+                Ok(()) => Ok(()),
+            };
+        }
+        // A skipped precondition is not a success observation.
+        if executed > 0 || result.is_err() {
+            assert_always!(
+                result.is_ok(),
+                "Lagging backfill crash episodes finish within the quiet window",
+                &json!({"executed": executed,
+                    "error": result.as_ref().err().map(|error| format!("{error:#}"))})
+            );
+        }
+        result
+    }
+
+    async fn lagging_crash_episode(
+        &self,
+        dir: &Path,
+        members: &[Address],
+        episode: usize,
+        quiet: bool,
+    ) -> eyre::Result<()> {
+        let (_, membership) = phase!(
+            quiet,
+            "Preconditions become ready",
+            PRECONDITION_TIMEOUT,
+            self.outage_preconditions(members)
+        )?;
+        let leader = members
+            .iter()
+            .position(|address| *address == membership.leader)
+            .ok_or_eyre("leader is not one of the controlled sequencers")?;
+        let followers: Vec<_> = (0..3).filter(|node| *node != leader).collect();
+        let follower = followers[random_index(followers.len())];
+        let mut heads = Vec::with_capacity(self.zones.len());
+        for zone in &self.zones {
+            let block = zone
+                .get_block_by_number(BlockNumberOrTag::Latest)
+                .await?
+                .ok_or_eyre("no pre-crash zone head")?;
+            heads.push(Head {
+                height: block.header.number,
+                hash: block.header.hash,
+                producer: block.header.beneficiary,
+            });
+        }
+        // Every height from the pre-fault common tip is compared after the crash.
+        let from = heads.iter().map(|head| head.height).min().ok_or_eyre("no zone heads")?;
+        let peak = heads.iter().map(|head| head.height).max().ok_or_eyre("no zone heads")?;
+
+        if random_below(2) == 0 {
+            let successor = follower;
+            let trigger = if random_below(10) < 3 {
+                Trigger::Blind {
+                    delay_ms: random_below(MAX_BLIND_DRAIN_MS + 1),
+                }
+            } else {
+                Trigger::Drain {
+                    delay_ms: random_below(MAX_TRIGGER_DELAY_MS + 1),
+                    leader,
+                    leader_head: heads[leader],
+                    successor: members[successor],
+                    epoch: membership.epoch,
+                }
+            };
+            let fsync_delay_ms = DRAIN_FSYNC_DELAYS_MS[random_index(DRAIN_FSYNC_DELAYS_MS.len())];
+            // Reserve cleanup before either the handoff or its trigger wait.
+            let mut leader_held = Hold::new(self, dir, leader)?;
+            let slow_fsync = SlowFsync::set(dir, leader, fsync_delay_ms)?;
+            let details = json!({"episode": episode, "kind": "drain", "quiet": quiet,
+                "leader": leader, "successor": successor, "epoch": membership.epoch,
+                "fsync_delay_ms": fsync_delay_ms, "trigger": trigger,
+                "heads_before_handoff": heads});
+            println!(
+                "lagging-backfill-crash: {}",
+                json!({"step": "slow_fsync_set", "details": details})
+            );
+            let receipt = phase!(
+                quiet,
+                "Drain handoff transaction is confirmed",
+                PRECONDITION_TIMEOUT,
+                async {
+                    let admin = Account::at(ADMIN_INDEX)?;
+                    let _lease = self
+                        .ledger
+                        .try_lease(&admin)?
+                        .ok_or_eyre("drain handoff admin is busy")?;
+                    let mut request = Request {
+                        id: self.ledger.next_id()?,
+                        previous_leader: membership.leader,
+                        expected_epoch: membership.epoch,
+                        target: members[successor],
+                        relayed: false,
+                        from_l1_block: self.l1.get_block_number().await?,
+                        l1_tx: None,
+                    };
+                    let receipt = self.submit_handoff(&admin, &mut request).await?;
+                    eyre::ensure!(
+                        receipt.status()
+                            && handoff_applied(
+                                receipt.inner.logs(),
+                                self.portal,
+                                receipt.transaction_hash,
+                            ),
+                        "drain handoff did not change leadership"
+                    );
+                    Ok(receipt)
+                }
+            )?;
+            let confirmed_at = Instant::now();
+            println!(
+                "lagging-backfill-crash: {}",
+                json!({"step": "handoff_confirmed", "details": details,
+                    "tx": receipt.transaction_hash, "l1_height": receipt.block_number,
+                    "l1_hash": receipt.block_hash})
+            );
+            phase!(
+                quiet,
+                "Drain kill trigger fires",
+                TRIGGER_WATCH + Duration::from_millis(MAX_TRIGGER_DELAY_MS),
+                await_trigger(self, successor, heads[successor].height, trigger, confirmed_at)
+            )?;
+            let kill_requested_after_ms = confirmed_at.elapsed().as_millis();
+            let (leader_head, successor_head, killed) = tokio::join!(
+                read_head(&self.zones[leader]),
+                read_head(&self.zones[successor]),
+                async {
+                    phase!(
+                        quiet,
+                        "Draining leader is SIGKILLed",
+                        RESTART_TIMEOUT,
+                        leader_held.kill()
+                    )
+                }
+            );
+            println!(
+                "lagging-backfill-crash: {}",
+                json!({"step": "leader_killed", "details": details,
+                    "leader_head": leader_head, "successor_head": successor_head,
+                    "kill_requested_after_ms": kill_requested_after_ms, "killed": killed.is_ok()})
+            );
+            // Reset before restart, and await cleanup even if the kill acknowledgement failed.
+            let cleared = slow_fsync.clear();
+            println!(
+                "lagging-backfill-crash: {}",
+                json!({"step": "slow_fsync_reset", "details": details,
+                    "reset": cleared.is_ok(), "leader_head": leader_head,
+                    "successor_head": successor_head})
+            );
+            let restarted = phase!(
+                quiet,
+                "Drained leader restarts",
+                RESTART_TIMEOUT,
+                leader_held.restore()
+            );
+            killed?;
+            cleared?;
+            restarted?;
+            println!(
+                "lagging-backfill-crash: {}",
+                json!({"step": "leader_restarted", "details": details,
+                    "head": read_head(&self.zones[leader]).await})
+            );
+            let kill_tip = peak
+                .max(leader_head.map_or(0, |head| head.height))
+                .max(successor_head.map_or(0, |head| head.height));
+            let common_tip = self.lagging_crash_convergence(from, kill_tip, quiet).await?;
+            assert_reachable!(
+                "Lagging backfill crash: All zone nodes agree on every common height and advance after a drain crash",
+                &details
+            );
+            println!(
+                "lagging-backfill-crash: {}",
+                json!({"step": "converged", "details": details,
+                    "compared_from": from, "common_tip": common_tip})
+            );
+            return Ok(());
+        }
+
+        let other = followers
+            .into_iter()
+            .find(|node| *node != follower)
+            .ok_or_eyre("no second follower")?;
+        // Lagging the other follower too leaves the leader as the only backfill source; both
+        // are released together before the kill, so both can backfill the same height.
+        let isolate = random_below(3) == 0;
+        let lag = match random_below(3) {
+            0 => Lag::Restart,
+            1 => Lag::Gate,
+            _ => Lag::Probe,
+        };
+        let lag_ms = match lag {
+            Lag::Gate => MIN_GATE_MS + random_below(MAX_GATE_MS - MIN_GATE_MS + 1),
+            Lag::Restart => MIN_HOLD_MS + random_below(MAX_HOLD_MS - MIN_HOLD_MS + 1),
+            Lag::Probe => 0,
+        };
+        let trigger = if matches!(lag, Lag::Probe) || random_below(2) == 0 {
+            Trigger::HeadMoves {
+                delay_ms: random_below(MAX_TRIGGER_DELAY_MS + 1),
+            }
+        } else {
+            Trigger::Blind {
+                delay_ms: random_below(MAX_TRIGGER_DELAY_MS + 1),
+            }
+        };
+        // The probe path needs one commit to stall past the follower's 30 s inactivity probe
+        // (and under the shim's 60 s cap).
+        let fsync_delay_ms = match lag {
+            Lag::Probe => 40_000 + random_below(15_001),
+            _ => FSYNC_DELAYS_MS[random_index(FSYNC_DELAYS_MS.len())],
+        };
+        let slow_fsync = SlowFsync::set(dir, leader, fsync_delay_ms)?;
+        let follower_base = self.zones[follower].get_block_number().await?;
+        println!(
+            "lagging-backfill-crash: {}",
+            json!({"step": "backfill_started", "episode": episode, "kind": "backfill",
+                "leader": leader, "follower": follower, "heads": heads,
+                "fsync_delay_ms": fsync_delay_ms, "lag": lag, "lag_ms": lag_ms, "trigger": trigger})
+        );
+
+        let base = match lag {
+            Lag::Gate => {
+                let mask = (1u8 << follower) | if isolate { 1u8 << other } else { 0 };
+                let lease = Duration::from_millis(lag_ms) + GATE_LEASE_MARGIN;
+                // The guard stays outside the phase future so a phase error still awaits heal.
+                let mut gate = None;
+                let partitioned = phase!(
+                    quiet,
+                    "Followers stay partitioned while the leader keeps producing",
+                    GATE_TIMEOUT,
+                    async {
+                        gate = Some(Fault::apply(dir, 0, mask, lease).await?);
+                        let gate = gate.as_ref().ok_or_eyre("network gate was not installed")?;
+                        gate.while_active(async {
+                            tokio::time::sleep(Duration::from_millis(lag_ms)).await;
+                            Ok(read_tip(&self.zones[follower]).await)
+                        })
+                        .await
+                    }
+                );
+                // Both followers are released together by one heal.
+                let healed = phase!(quiet, "Network gate heals", HEAL_TIMEOUT, async {
+                    match gate.as_mut() {
+                        Some(gate) => gate.heal().await,
+                        // A failed install already cancelled its own lease; without quiet,
+                        // another driver's lease must not be released.
+                        None if quiet => release_network_faults(dir).await,
+                        None => Ok(()),
+                    }
+                });
+                let base = partitioned?;
+                healed?;
+                base.unwrap_or(follower_base).max(follower_base)
+            }
+            Lag::Probe => {
+                // Let broadcasts of already-committed blocks drain, so only the probe moves the head.
+                tokio::time::sleep(Duration::from_secs(3)).await;
+                read_tip(&self.zones[follower])
+                    .await
+                    .unwrap_or(follower_base)
+                    .max(follower_base)
+            }
+            Lag::Restart => {
+                let mut held = Hold::new(self, dir, follower)?;
+                let mut other_held = isolate.then(|| Hold::new(self, dir, other)).transpose()?;
+                let down = phase!(
+                    quiet,
+                    "Followers stay down while the leader keeps producing",
+                    HOLD_TIMEOUT,
+                    async {
+                        held.kill().await?;
+                        if let Some(other_held) = &other_held {
+                            other_held.kill().await?;
+                        }
+                        let sleep = async {
+                            tokio::time::sleep(Duration::from_millis(lag_ms)).await;
+                            Ok(())
+                        };
+                        held.while_down(async {
+                            match &other_held {
+                                Some(other_held) => other_held.while_down(sleep).await,
+                                None => sleep.await,
+                            }
+                        })
+                        .await
+                    }
+                );
+                // Always request and confirm restart before propagating a held-down phase
+                // failure; both followers restart together.
+                let (restored, other_restored) = tokio::join!(
+                    async {
+                        phase!(
+                            quiet,
+                            "Held follower restarts",
+                            RESTART_TIMEOUT,
+                            held.restore()
+                        )
+                    },
+                    async {
+                        match other_held.as_mut() {
+                            Some(other_held) => phase!(
+                                quiet,
+                                "Isolated follower restarts",
+                                RESTART_TIMEOUT,
+                                other_held.restore()
+                            ),
+                            None => Ok(()),
+                        }
+                    }
+                );
+                down?;
+                restored?;
+                other_restored?;
+                follower_base
+            }
+        };
+
+        // Reserved before the trigger wait, so the kill is one control-file write away.
+        let mut leader_held = Hold::new(self, dir, leader)?;
+        await_trigger(self, follower, base, trigger, Instant::now()).await?;
+        let (follower_tip, leader_tip, killed) = tokio::join!(
+            read_tip(&self.zones[follower]),
+            read_tip(&self.zones[leader]),
+            leader_held.kill()
+        );
+        // Restore normal fsync before the restart: a slow commit only matters while the
+        // leader is serving the uncommitted tip, and it would otherwise stall recovery.
+        let cleared = slow_fsync.clear();
+        let crashed = phase!(
+            quiet,
+            "Leader is SIGKILLed and restarts",
+            RESTART_TIMEOUT,
+            async {
+                killed?;
+                leader_held.restore().await
+            }
+        );
+        cleared?;
+        let catching_up = matches!((follower_tip, leader_tip), (Some(f), Some(l)) if f < l);
+        let moving = follower_tip.is_some_and(|tip| tip > base);
+        let details = json!({
+            "episode": episode,
+            "kind": "backfill",
+            "quiet": quiet,
+            "leader": leader,
+            "follower": follower,
+            "isolated_other_follower": isolate,
+            "lag": lag,
+            "lag_ms": lag_ms,
+            "trigger": trigger,
+            "fsync_delay_ms": fsync_delay_ms,
+            "follower_base": base,
+            "follower_tip_at_kill": follower_tip,
+            "leader_tip_at_kill": leader_tip,
+        });
+        assert_sometimes!(
+            crashed.is_ok() && catching_up,
+            "Lagging backfill crash: Leader kill lands while the lagging follower is still catching up",
+            &details
+        );
+        assert_sometimes!(
+            crashed.is_ok() && catching_up && moving,
+            "Lagging backfill crash: Leader kill lands while the lagging follower's head is moving",
+            &details
+        );
+        crashed?;
+
+        // An unreadable leader tip falls back to the highest tip seen before the lag.
+        let kill_tip = leader_tip.unwrap_or(peak).max(follower_tip.unwrap_or(0));
+        let common_tip = self.lagging_crash_convergence(from, kill_tip, quiet).await?;
+        assert_reachable!(
+            "Lagging backfill crash: All zone nodes agree on every common height after a leader crash during follower catch-up",
+            &details
+        );
+        println!(
+            "lagging-backfill-crash: {}",
+            json!({"details": details, "catching_up": catching_up, "moving": moving,
+                "compared_from": from, "common_tip": common_tip})
+        );
+        Ok(())
+    }
+
+    async fn lagging_crash_convergence(
+        &self,
+        from: u64,
+        kill_tip: u64,
+        quiet: bool,
+    ) -> eyre::Result<u64> {
+        phase!(
+            quiet,
+            "Zone nodes converge on identical blocks after the leader crash",
+            CONVERGENCE_TIMEOUT,
+            recover_until(Instant::now() + CONVERGENCE_TIMEOUT, async || {
+                let observed = self
+                    .observe_forks(Some(from), "lagging-backfill-crash")
+                    .await;
+                if !observed.divergent.is_empty() {
+                    return Err(eyre::Report::new(Forked)
+                        .wrap_err(format!("divergent heights: {:?}", observed.divergent)));
+                }
+                let common_tip = observed
+                    .common_tip
+                    .filter(|tip| observed.unreachable.is_empty() && *tip > kill_tip);
+                if let Some(tip) = common_tip {
+                    let mut hashes = Vec::with_capacity(self.zones.len());
+                    for zone in &self.zones {
+                        let Some(block) = zone.get_block_by_number(tip.into()).await? else {
+                            return Ok(None);
+                        };
+                        hashes.push(block.header.hash);
+                    }
+                    if hashes.iter().any(|hash| *hash != hashes[0]) {
+                        return Ok(None);
+                    }
+                    println!(
+                        "lagging-backfill-crash: {}",
+                        json!({"step": "common_hashes", "height": tip,
+                            "hashes": hashes, "compared_from": from})
+                    );
+                }
+                Ok(common_tip)
+            })
+        )
+    }
+}
